# Always check for a new version of the page itself, so phones never keep an old build.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
# Built files have a content hash in their name, so they can be cached for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/img/*
  Cache-Control: public, max-age=604800
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/sw.js
  Cache-Control: no-cache
# The apps poll this to know when the site has changed.
/app-manifest.json
  Cache-Control: no-cache
  Access-Control-Allow-Origin: *
